{
  "ApplicationKnowledge": {
    "FilePath": "Knowledge/application-architecture.json"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApplicationIntelligence": {
    "RootPath": "ApplicationKnowledge",
    "FailOnInvalidPackage": true,
    "RequireAtLeastOnePackage": true,
    "ReloadOnStartup": true
  },
  "AI": {
    "Provider": "Ollama",
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "llama3.2:3b",
      "TimeoutSeconds": 60,
      "Temperature": 0.1,
      "MaxOutputTokens": 400,
      "ContextWindow": 4096,
      "Enabled": true
    }
  }
}

